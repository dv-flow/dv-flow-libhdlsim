package:
  name: hdlsim.vlt
  desc: Verilator open-source simulator integration for fast HDL simulation

  # Waveform format for trace-enabled (debug) builds. FST by default (far more
  # compact than VCD for large designs). The debug arg presets read it as the
  # qualified `${{ hdlsim.vlt.trace_fmt }}`: the elab preset maps it to the
  # Verilator tracer flag (fst->--trace-fst, vcd->--trace) and the run preset to
  # the +trace=waves.<fmt> dump-file name, so build flag and file extension
  # agree from this one knob. Override with `-D hdlsim.vlt.trace_fmt=vcd` (or a
  # `set:` subtree rebind).
  with:
    trace_fmt:
      type: str
      value: "fst"

  imports:
  - name: hdlsim

  tasks:
  - export: SimImage
    uses: hdlsim.SimImage
    pytask: dv_flow.libhdlsim.vlt_sim_image.SimImage
    uptodate: dv_flow.libhdlsim.vlt_sim_image.check_uptodate
    desc: Compiles HDL sources into a Verilator simulation executable
    doc: |
      Compiles SystemVerilog/Verilog sources using Verilator into a C++
      simulation executable. Verilator converts the HDL into optimized
      C++ code which is then compiled with a C++ compiler.
      
      Example:
      ```yaml
      - name: build
        uses: hdlsim.vlt.SimImage
        needs: [rtl]
        with:
          top: [my_module]
          trace: true  # Enable FST waveform dump
      ```
      
      Common issues:
      - "Unsupported" errors: Verilator doesn't support all SV constructs
      - Slow compile: Use VERILATOR_JOBS env var for parallel C++ compilation
    with:
      vpi:
        doc: |
          Build with Verilator's VPI runtime (--vpi). Needed by any C code
          that makes VPI calls. Enabled automatically when a VPI library is
          linked or when a library (eg SimLibUVM) requests it.
        type: bool
        value: false
      public_flat_rw:
        doc: |
          Expose all signals for read/write access (--public-flat-rw).
          Required to reach signals not marked /*verilator public*/ through
          VPI, eg for UVM register backdoor access. Inhibits optimization,
          so it is off unless explicitly requested.
        type: bool
        value: false

  - export: SimLib
    uses: hdlsim.SimLib
    passthrough: all
    desc: Passthrough for Verilator (no pre-compiled library support)
    doc: |
      Verilator doesn't have a notion of a pre-compiled library.
      Consequently, this task is implemented as a passthrough that
      forwards all input data to the output unchanged.


  - export: ProtectLib
    uses: hdlsim.SimImage
    pytask: dv_flow.libhdlsim.vlt_protect_lib.ProtectLib
    desc: Builds a Verilator --protect-lib DPI library + SV wrapper
    doc: |
      Compiles RTL sources into a Verilator --protect-lib output.
      Produces two filesets:
      - systemVerilogSource: the generated SV DPI wrapper
      - systemVerilogDPI: the shared library (.so)
      
      The SV wrapper is a drop-in replacement module with the same ports
      as the original RTL. VCS compiles the wrapper and links the .so at
      elaboration time via -sv_lib.
      
      Example:
      ```yaml
      - name: vemb
        uses: hdlsim.vlt.ProtectLib
        needs: [rtl-sources]
        with:
          top: [my_module]
          libname: verilated_my_module
      ```
    with:
      libname:
        doc: Name for the protect-lib output (default uses top module name)
        type: str
        value: ""
      jobs:
        doc: Parallel C++ compilation jobs (0 = auto-detect)
        type: int
        value: 0
  - export: SimLibUVM
    uses: hdlsim.SimLibUVM
    pytask: dv_flow.libhdlsim.vlt_sim_lib_uvm.SimLibUVM
    desc: Provides UVM library support for Verilator
    doc: |
      Provides the UVM library configured for Verilator simulation.
      Uses the built-in UVM library or a user-specified UVM installation.

      When the UVM installation ships a Verilator DPI backend (verilator-bin
      installs one into share/uvm/src/dpi), the DPI layer is used: UVM gets
      real regular-expression matching and register backdoor access, and the
      image is built with --vpi. Otherwise UVM_NO_DPI is defined as a
      fallback, which downgrades uvm_re_match to glob-only matching.

      Backdoor access additionally requires the target signals to be visible
      to VPI -- mark them /*verilator public*/ or set public_flat_rw on
      SimImage.

      Example:
      ```yaml
      tasks:
        - name: uvm
          uses: hdlsim.vlt.SimLibUVM
        - name: build
          uses: hdlsim.vlt.SimImage
          needs: [rtl, uvm, tb]
      ```
    with:
      dpi:
        doc: |
          Use the UVM DPI layer: "auto" (default) uses it when the UVM
          installation provides a Verilator backend and warns when falling
          back; "true" errors instead of falling back, for flows that must
          not silently lose regex matching; "false" forces UVM_NO_DPI.
        type: str
        value: "auto"

  - export: SimRun
    uses: hdlsim.SimRun
    pytask: dv_flow.libhdlsim.vlt_sim_run.SimRun
    desc: Executes a Verilator simulation
    doc: |
      Runs a previously compiled Verilator simulation executable.
      
      Example:
      ```yaml
      - name: run
        uses: hdlsim.vlt.SimRun
        needs: [build]
        with:
          plusargs: [UVM_TESTNAME=my_test]
          trace: true
      ```

  - export: SimUVMCase
    uses: hdlsim.SimUVMCase
    pytask: dv_flow.libhdlsim.vlt_sim_uvm_case.SimUVMCase
    desc: Run one Verilator UVM test (run + verdict) and emit a TestResult

  - export: SimCovMerge
    uses: hdlsim.SimCovMerge
    pytask: dv_flow.libhdlsim.cov_merge.VltSimCovMerge
    desc: Merge Verilator coverage databases into one

  #------------------------------------------------------------------
  # Per-sim opt/debug flag sets (see hdlsim.SimCompArgsOpt et al.).
  # Selected by the `sim`-driven elaborator; each emits the matching
  # hdlsim.Sim*Args DataItem carrying this simulator's default flags
  # for the mode. Flag lists are placeholders ([]) until the correct
  # Verilator flags are established.
  #------------------------------------------------------------------
  - export: SimCompArgsOpt
    uses: hdlsim.SimCompileArgs
    consumes: none
    desc: Verilator optimized-mode compile flags
    with: { args: { type: list, value: [] } }

  - export: SimCompArgsDbg
    uses: hdlsim.SimCompileArgs
    consumes: none
    desc: Verilator debug-mode compile flags
    with: { args: { type: list, value: [] } }

  - export: SimElabArgsOpt
    uses: hdlsim.SimElabArgs
    consumes: none
    desc: Verilator optimized-mode elaboration flags
    with: { args: { type: list, value: [] } }

  - export: SimElabArgsDbg
    uses: hdlsim.SimElabArgs
    consumes: none
    desc: Verilator debug-mode elaboration flags
    doc: |
      Verilator debug elaboration flags. Enables waveform tracing: `trace_fmt`
      defaults to the `hdlsim.vlt.trace_fmt` var (FST), which the image builder
      maps to the tracer flag (fst->`--trace-fst`, vcd->`--trace`). Flip with
      `-D hdlsim.vlt.trace_fmt=vcd`. Any Verilator-specific debug elab flags go
      in `args`.
    with: { trace_fmt: { type: str, value: "${{ hdlsim.vlt.trace_fmt }}" } }

  - export: SimRunArgsOpt
    uses: hdlsim.SimRunArgs
    consumes: none
    desc: Verilator optimized-mode runtime flags
    with: { args: { type: list, value: [] } }

  - export: SimRunArgsDbg
    uses: hdlsim.SimRunArgs
    consumes: none
    desc: Verilator debug-mode runtime flags
    doc: |
      Verilator debug runtime flags. Passes `+trace=waves.<fmt>`, whose
      extension follows the package `trace_fmt` var so the file name matches the
      format the image was built with; the testbench reads it via
      `$value$plusargs("trace=%s", f)`. `trace` is a project-side plusarg name
      -- Verilator reserves only the `+verilator+*` namespace, so `+trace` does
      not collide. Any Verilator-specific debug run flags would go in `args`.
    with: { plusargs: { type: list, value: ["trace=waves.${{ hdlsim.vlt.trace_fmt }}"] } }

  types:
  - name: AgentSkill
    uses: std.DataItem
    tags:
      - std.AgentSkillTag
    doc: Verilator simulation skill for LLM agent discovery
    with:
      name:
        type: str
        value: "verilator-simulation"
      desc:
        type: str
        value: "Compile and run simulations with Verilator"
      skill_doc:
        type: str
        value: |
          # Verilator Simulation (hdlsim.vlt)
          
          Open-source SystemVerilog simulator that compiles HDL to optimized C++.
          Best for unit-level verification and high-performance simulation.
          
          ## Features
          - Fast compilation and execution
          - FST waveform tracing
          - Linting and code quality checks
          - Open source (no license required)
          
          ## Limitations
          - No dynamic process support (fork/join)
          - Limited assertion support
          - No timing simulation
          
          ## Quick Start
          
          ```yaml
          package:
            name: my_sim
            
            imports:
              - name: hdlsim.vlt
                as: sim
            
            tasks:
              - name: rtl
                uses: std.FileSet
                with:
                  type: systemVerilogSource
                  include: "src/**/*.sv"
              
              - name: build
                uses: sim.SimImage
                needs: [rtl]
                with:
                  top: [my_module]
                  trace: true
              
              - name: run
                uses: sim.SimRun
                needs: [build]
          ```
          
          ## With UVM
          
          ```yaml
          tasks:
            - name: uvm
              uses: sim.SimLibUVM
            
            - name: tb
              uses: std.FileSet
              with:
                type: systemVerilogSource
                include: "tb/**/*.sv"
            
            - name: build
              uses: sim.SimImage
              needs: [rtl, uvm, tb]
              with:
                top: [tb_top]
          ```
          
          ## Coverage
          
          Wire `uses: hdlsim.SimCovArgs` into SimImage and set the level with
          `-D hdlsim.cov=func|code|full` (or `with: { level: code }`). func =
          covergroups + `cover property` (`--coverage-user`); code adds line,
          branch, expression; full adds toggle and FSM. The run writes
          `coverage.dat` (a `simCovDb` artifact, `format=vlt-dat`) and reports
          `cov_<kind>_pct` stats. `cg.get_coverage()` returns 0 on Verilator,
          and UVM code is instrumented along with the design.
          
          ## Tasks
          
          - `SimImage`: Compile HDL to simulation executable
          - `SimRun`: Execute the simulation
          - `SimLib`: Passthrough (no pre-compiled library support)
          - `SimLibUVM`: UVM library support
