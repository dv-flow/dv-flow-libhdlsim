package:
  name: hdlsim
  desc: HDL simulation package providing tasks for compiling and running simulations with various simulators

  # Global simulator selection (Feature C). Set with `-D hdlsim.sim=vlt` or a
  # subtree `set: [{ hdlsim.sim: <name> }]` override. The abstract
  # SimImage/SimRun/SimLib/SimLibUVM tasks read it by ordinary reference
  # (`${{ hdlsim.sim }}`); a bound BackendSelectElaborator dispatches to
  # hdlsim.<sim>.<task>. "unset" is the misconfig sentinel the selector reports
  # on. (Per-leg control: `set: [{ uses: "hdlsim.*", path: "smoke/**",
  # set: [{ sim: <name> }] }]`.)
  with:
    sim:
      type: str
      value: "unset"

  tasks:
  # `produces:` is declared ONCE on each generic export; the per-simulator
  # variants (vlt/vcs/mti/...) inherit it, since inheritance is nearest-wins and
  # they do not redeclare. A backend that genuinely emits something extra says so.
  #
  # Kept COARSE deliberately: the item type, plus attributes fixed by the task's
  # own parameters. What a run actually emitted is a runtime property and is not
  # claimed here.
  - export: SimLib
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    produces:
    - type: std.FileSet
      filetype: simLib
    desc: Creates a pre-compiled simulation library
    doc: |
      SimLib compiles HDL source files into a pre-compiled simulation library
      that can be reused across multiple simulation builds. This improves 
      compilation time for large designs with shared libraries.
      
      The library is created with the specified libname and includes all
      consumed source files. Use `needs` to specify source file dependencies.
    passthrough: unused
    consumes:
    - filetype: simLib
    - filetype: systemVerilogInclude 
    - filetype: systemVerilogSource 
    - filetype: verilogInclude 
    - filetype: verilogIncDir 
    - filetype: verilogSource 
    - type: hdlsim.SimCompileArgs
    - type: hdlsim.SuppressWarnings
    with:
      sim:
        doc: Simulator backend selector (see package sim); reads hdlsim.sim (CLI / set / with)
        type: str
        value: "${{ hdlsim.sim:-unset }}"
      args:
        doc: Additional compiler arguments
        type: list
      libname:
        doc: Name of the library to create
        type: str
        value: ""
      incdirs:
        doc: Include directories for compilation
        type: list
      defines:
        doc: Preprocessor defines
        type: list
      propagate_incdirs:
        doc: Whether to propagate include directories to consumers
        type: bool
        value: true
      suppress_warnings:
        doc: Warning codes to suppress from becoming markers (e.g., [TFIPC, vlog-2623])
        type: list

  - export: SimLibVPI
    desc: Creates a VPI (Verilog Procedural Interface) library
    doc: |
      SimLibVPI compiles C/C++ source files into a VPI library that can be
      loaded by the simulator at runtime. VPI provides programmatic access
      to simulation objects.
    consumes:
    - filetype: cSource
    - filetype: cppSource
    with:
      libname:
        doc: Name of the VPI library
        type: str
        value: ""
      incdirs:
        doc: Include directories for C/C++ compilation
        type: list
      defines:
        doc: Preprocessor defines
        type: list

  - export: SimLibDPI
    desc: Creates a DPI (Direct Programming Interface) library
    doc: |
      SimLibDPI compiles C/C++ source files into a DPI library. DPI provides
      a standard interface between SystemVerilog and C/C++ code.
    consumes:
    - filetype: cSource
    - filetype: cppSource
    with:
      libname:
        doc: Name of the DPI library
        type: str
        value: ""
      incdirs:
        doc: Include directories for C/C++ compilation
        type: list
      defines:
        doc: Preprocessor defines
        type: list

  - export: SimLibUVM
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    desc: Provides UVM (Universal Verification Methodology) library support
    doc: |
      SimLibUVM provides the UVM library for the target simulator. Each
      simulator package provides its own implementation that configures
      the appropriate UVM library paths and compilation settings.
      
      Example:
      ```yaml
      tasks:
        - name: uvm
          uses: sim.SimLibUVM
        - name: build
          uses: sim.SimImage
          needs: [rtl, uvm, tb]
      ```
    with:
      sim:
        doc: Simulator backend selector (see package sim); reads hdlsim.sim (CLI / set / with)
        type: str
        value: "${{ hdlsim.sim:-unset }}"

  - export: SimImage
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    produces:
    - type: std.FileSet
      filetype: simDir
    # Only some backends load VPI at run time (see forward_vpi), so this is a
    # "may produce" -- which is what `produces:` means.
    - type: std.FileSet
      filetype: verilogVPI
    desc: Compiles HDL sources into a simulation executable
    doc: |
      SimImage compiles SystemVerilog/Verilog source files into a simulation
      executable (or image). This is the main compilation task for simulation.
      
      The task consumes source files from its dependencies and produces a
      simulation directory containing the compiled executable.
      
      Example:
      ```yaml
      tasks:
        - name: build
          uses: sim.SimImage
          needs: [rtl, tb]
          with:
            top: [tb_top]
            trace: true
      ```
    consumes:
    - filetype: cSource
    - filetype: cppSource
    - filetype: systemVerilogInclude
    - filetype: systemVerilogSource
    - filetype: simLib
    - filetype: simPrimary
    - filetype: verilogIncDir
    - filetype: verilogInclude
    - filetype: verilogSource
    - filetype: systemVerilogDPI
    - filetype: verilogVPI
    - filetype: verilatorMain
    - type: hdlsim.SimElabArgs
    - type: hdlsim.SimCompileArgs
    - type: hdlsim.SuppressWarnings
    with:
      sim:
        doc: Simulator backend selector (see package sim); reads hdlsim.sim (CLI / set / with)
        type: str
        value: "${{ hdlsim.sim:-unset }}"
      top:
        doc: Top-level module name(s)
        type: list
      args:
        doc: Additional compiler/elaborator arguments
        type: list
      compargs:
        doc: Compilation-specific arguments
        type: list
      elabargs:
        doc: Elaboration-specific arguments
        type: list
      trace:
        doc: Enable waveform tracing
        type: bool
      timing:
        doc: Enable timing simulation
        type: bool
        value: true
      dpilibs:
        doc: DPI libraries to link
        type: list
      vpilibs:
        doc: VPI libraries to link
        type: list
      incdirs:
        doc: Include directories
        type: list
      defines:
        doc: Preprocessor defines
        type: list
      suppress_warnings:
        doc: Warning codes to suppress from becoming markers (e.g., [TFIPC, vlog-2623])
        type: list


  - export: SimRun
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    desc: Executes a compiled simulation
    produces:
    - type: hdlsim.SimRunResult
      sim: "${{ sim }}"
      mode: "${{ mode }}"
    doc: |
      SimRun executes a previously compiled simulation image. It consumes the
      simulation directory from SimImage and runs the simulation with the
      specified arguments.
      
      Example:
      ```yaml
      tasks:
        - name: run
          uses: sim.SimRun
          needs: [build]
          with:
            plusargs: [UVM_TESTNAME=my_test]
      ```
    consumes:
    - filetype: simDir
    - filetype: systemVerilogDPI
    - filetype: verilogVPI
    - filetype: simRunData
    - type: hdlsim.SimRunArgs
    uptodate: false
    with:
      sim:
        doc: Simulator backend selector (see package sim); reads hdlsim.sim (CLI / set / with)
        type: str
        value: "${{ hdlsim.sim:-unset }}"
      mode:
        doc: |
          Run mode. "run" (default): the task fails on a nonzero simulator exit
          code, matching a plain build-and-run. "test": the task never fails on
          a nonzero exit -- the exit code is carried in the emitted SimRunResult
          and the pass/fail verdict is decided downstream by a Check task. Used
          by SimCase so one failing case does not abort a suite.
        type: str
        value: "run"
      args:
        doc: Runtime arguments
        type: list
      plusargs:
        doc: Simulation plusargs (e.g., UVM_TESTNAME=test)
        type: list
      dpilibs:
        doc: DPI libraries to load at runtime
        type: list
      vpilibs:
        doc: VPI libraries to load at runtime
        type: list
      trace:
        doc: Enable runtime tracing
        type: bool
      valgrind:
        doc: Run simulation under valgrind for memory checking
        type: bool

  - export: SimArgs
    uses: hdlsim.SimCompileArgs

  #------------------------------------------------------------------
  # Per-sim opt/debug flag selectors.
  #
  # These abstract tasks pick the correct simulator-specific flag set
  # for optimized ('...Opt') or debug ('...Dbg') builds, driven by the
  # global `hdlsim.sim` selection. The bound elaborator (backend_select)
  # reads the resolved `sim` and rebinds `uses` to the concrete per-sim
  # emitter `hdlsim.<sim>.<Family>` (e.g. hdlsim.vlt.SimCompArgsOpt),
  # which produces the matching hdlsim.Sim*Args DataItem consumed by
  # SimImage / SimLib / SimRun.
  #
  # Only `sim` is declared here; args/incdirs/defines are inherited from
  # the base Sim*Args type, so the concrete emitter's flags flow through
  # (a user-supplied `args` on the instance replaces them). `sim` drives
  # selection only and is never part of the emitted DataItem.
  #------------------------------------------------------------------
  - export: SimCompArgsOpt
    uses: SimCompileArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Optimized-mode compile flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  - export: SimCompArgsDbg
    uses: SimCompileArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Debug-mode compile flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  - export: SimElabArgsOpt
    uses: SimElabArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Optimized-mode elaboration flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  - export: SimElabArgsDbg
    uses: SimElabArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Debug-mode elaboration flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  - export: SimRunArgsOpt
    uses: SimRunArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Optimized-mode runtime flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  - export: SimRunArgsDbg
    uses: SimRunArgs
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    consumes: none
    desc: Debug-mode runtime flags; selects the per-sim set from hdlsim.sim
    with: { sim: { type: str, value: "${{ hdlsim.sim:-unset }}" } }

  #------------------------------------------------------------------
  # Verdict tasks: turn a SimRunResult into an interpreted TestResult.
  #
  # These are simulator-AGNOSTIC pytasks (they read the log file a SimRun wrote;
  # no simulator is invoked), so unlike SimRun/SimImage they do NOT dispatch via
  # backend_select -- the pytask is bound directly.
  #------------------------------------------------------------------
  - export: SimCheck
    produces:
    - type: hdlsim.TestResult
    desc: Interpret a SimRunResult into a pass/fail TestResult (generic; verdict from exit code)
    doc: |
      SimCheck consumes a SimRunResult (produced by a SimRun in `mode: test`)
      and emits a TestResult carrying the pass/fail verdict plus the artifact
      FileSets forwarded from the run. The generic base decides the verdict from
      the simulator exit code; SimUVMCheck overrides it to parse the UVM report
      summary (a UVM $finish exits 0 even with UVM_ERROR>0, so the exit code is
      NOT the verdict).

      Run it with `rundir: inherit` alongside its SimRun so both share the run
      directory (the check locates `sim.log` there). On a non-pass the task
      emits an Error marker for visibility but still returns success, so one
      failing case does not abort a suite -- the gate is SimSuiteReport.
    pytask: dv_flow.libhdlsim.sim_check.SimCheck
    consumes:
    - type: hdlsim.SimRunResult
    uptodate: false
    with:
      name:
        doc: Case name recorded in the emitted TestResult
        type: str
        value: ""
      testname:
        doc: Test identity (e.g. UVM_TESTNAME) recorded in the emitted TestResult
        type: str
        value: ""
      uvm:
        doc: |
          When true, parse the UVM report summary for the verdict (delegates to
          SimUVMCheck) instead of using the simulator exit code. SimUVMCase sets
          this via an ordinary param override, avoiding a compound-subtask
          override of the check task.
        type: bool
        value: false

  - export: SimUVMCheck
    uses: SimCheck
    desc: UVM-aware check -- parses the UVM report summary for the authoritative verdict
    doc: |
      SimUVMCheck is the UVM specialization of SimCheck. It parses the tail of
      the UVM simulation log for the `--- UVM Report Summary ---` block
      (UVM_ERROR / UVM_FATAL counts + the `** TEST PASSED/FAILED **` line) and
      falls back to an anchored whole-file scan only when the summary is absent
      (crash / hang). `passed = UVM_ERROR==0 and UVM_FATAL==0`.
    pytask: dv_flow.libhdlsim.sim_check.SimUVMCheck

  - export: SimSuiteReport
    uses: std.TestRunner
    produces:
    - type: hdlsim.SuiteResult
    - type: std.FileSet
      filetype: junitXml
    desc: Roll up a suite's TestResults into a SuiteResult and gate CI
    doc: |
      SimSuiteReport consumes every TestResult produced by a suite's cases (a
      matrix task's output aggregates all body cells) and emits a single
      SuiteResult with pass/fail/error counts. Its task status is nonzero iff
      any case did not pass -- that status is the suite's CI gate. Individual
      failing cases still run and are reported (they do not abort the suite),
      because each SimCase runs in `mode: test` and its check returns success.

      Via `std.TestRunner` it is also the project's test-execution *command*:
      the cases and suites it `needs:` can be selected from the command line
      (`--tests` / `--views`), and the selection prunes the graph so a
      deselected case -- and any image only it needed -- is never built. The
      end-of-run report comes from the same base.
    pytask: dv_flow.libhdlsim.sim_check.SimSuiteReport
    consumes:
    - type: hdlsim.TestResult
    uptodate: false
    with:
      # A case's short name lives in the `name` field of a suite matrix cell,
      # and the DUT view is the `image` axis. Both are what this project family
      # already writes; std.TestRunner's defaults are `name`/`view`.
      view_axis:
        type: str
        value: image
      junit:
        type: bool
        value: true
        doc: |
          Write junit.xml into the report's rundir (emitted as a junitXml
          FileSet). JUnit is what CI systems read natively, so this is what
          turns a suite into a GitHub/GitLab test view.

  - export: SimSuiteInfo
    uses: std.TestInfo
    # Writes tests-info.json for scripted use; emits no data item.
    produces: []
    desc: Report the cases and DUT views a SimSuiteReport root offers
    doc: |
      The introspection companion to `SimSuiteReport`: it lists what `--tests`
      and `--views` accept, and builds nothing -- no image is compiled.

      ```yaml
      - root: tests-info
        uses: hdlsim.SimSuiteInfo
        with: { target: tests }
      ```
    with:
      # Must match SimSuiteReport's: the case name is a cell's `name` field and
      # the DUT view is the `image` axis.
      view_axis:
        type: str
        value: image

  #------------------------------------------------------------------
  # SimUVMCase -- the compact "run one UVM test" task: a SINGLE leaf task that
  # runs the simulator (in test mode: a failing test never aborts a suite) AND
  # parses the UVM report summary, emitting a TestResult. A user writes just one
  # task per case with `testname` (+ optional `plusargs`); the sim image is
  # injected through `needs:`.
  #
  # It is a LEAF (not a compound) on purpose: a compound instantiated more than
  # once collides on subtask node names (only one instance's output survives
  # aggregation -- see docs/sim_case_suite_impl_plan.md), whereas distinct leaf
  # instances get distinct names. `uses: hdlsim.SimRun` inherits the run params
  # + consumes + backend dispatch; the concrete hdlsim.<sim>.SimUVMCase pytask
  # runs-then-checks. `SimUVMCase` is itself a backend_select family, so it
  # dispatches ahead of the inherited SimRun family.
  #------------------------------------------------------------------
  - export: SimUVMCase
    uses: hdlsim.SimRun
    elaborate: dv_flow.libhdlsim.backend_select:elaborate
    # Replaces the inherited SimRunResult claim: this task reports a verdict,
    # not a raw run. Nearest-wins inheritance is what makes that statable.
    produces:
    - type: hdlsim.TestResult
      name: "${{ name }}"
      testname: "${{ testname }}"
    desc: Run one UVM test (run + verdict in one task) and emit a TestResult
    doc: |
      SimUVMCase runs a single UVM test and reports its pass/fail verdict as a
      TestResult -- run and check in ONE task. Give it a `testname` (used as
      +UVM_TESTNAME) and, optionally, extra `plusargs`; inject the sim image via
      `needs:`. It always runs in test mode (the UVM $finish exit code is not the
      verdict), so a failing case never aborts a suite -- gate a group of cases
      with SimSuiteReport.

      ```yaml
      - root: uvm-wb-arb
        uses: hdlsim.vlt.SimUVMCase
        needs: [uvm-wb-img]
        with: { testname: wb_dma_arb_test, plusargs: [CMP_BY_CHANNEL] }
      ```
    with:
      testname:
        doc: UVM test to run (emitted as +UVM_TESTNAME and recorded in the TestResult)
        type: str
        value: ""
      name:
        doc: Case name for the TestResult (defaults to `testname`)
        type: str
        value: ""

  types:
  - name: AgentSkill
    uses: std.DataItem
    tags:
      - std.AgentSkillTag
    doc: |
      HDL simulation package skill for LLM agent discovery.
    with:
      name:
        type: str
        value: "hdl-simulation"
      desc:
        type: str
        value: "Configure and run HDL simulations with various simulators"
      skill_doc:
        # CAUTION: this is a parameter VALUE, so a literal `${{ ... }}` anywhere
        # below is expanded at load and will fail the package with something
        # like "Variable 'this' not found". There is no escape -- write flow
        # expressions as `{{ ... }}` with a note, as the suite example does.
        type: str
        value: |
          # HDL Simulation Package (hdlsim)
          
          The hdlsim package provides tasks for compiling and running HDL simulations
          with various commercial and open-source simulators.
          
          ## Supported Simulators
          
          | Package | Simulator | License |
          |---------|-----------|---------|
          | `hdlsim.vlt` | Verilator | Open Source |
          | `hdlsim.vcs` | Synopsys VCS | Commercial |
          | `hdlsim.xsm` | Cadence Xcelium | Commercial |
          | `hdlsim.mti` | Siemens Questa | Commercial |
          
          ## Quick Start
          
          ```yaml
          package:
            name: my_sim
            
            imports:
              - name: hdlsim.vlt  # Or hdlsim.vcs, hdlsim.xsm, hdlsim.mti
                as: sim
            
            tasks:
              - name: rtl
                uses: std.FileSet
                with:
                  type: systemVerilogSource
                  include: "src/**/*.sv"
              
              - name: build
                uses: sim.SimImage
                needs: [rtl]
                with:
                  top: [my_top]
              
              - name: run
                uses: sim.SimRun
                needs: [build]
          ```
          
          ## Core Tasks
          
          ### SimImage
          Compiles HDL sources into a simulation executable.
          - `top`: Top-level module names
          - `trace`: Enable waveform tracing
          - `timing`: Enable timing simulation
          - `args`: Additional compiler arguments
          
          ### SimRun
          Executes a compiled simulation.
          - `plusargs`: Simulation plusargs (e.g., UVM_TESTNAME=test)
          - `args`: Runtime arguments
          - `trace`: Enable runtime tracing
          
          ### SimLib
          Creates a pre-compiled simulation library.
          - `libname`: Library name
          - `args`: Compilation arguments
          
          ### SimLibUVM
          Provides UVM library support for the simulator.
          
          ## With UVM
          
          ```yaml
          tasks:
            - name: uvm
              uses: sim.SimLibUVM
            
            - name: tb
              uses: std.FileSet
              with:
                type: systemVerilogSource
                include: "tb/**/*.sv"
                attributes: [testbench, uvm]
            
            - name: build
              uses: sim.SimImage
              needs: [rtl, uvm, tb]
              with:
                top: [tb_top]
          ```
          
          ## Test Cases, Suites, and Running Tests

          A UVM test case is one leaf task. `SimUVMCase` runs the simulator
          (in `mode: test`, so a failing test never aborts the suite) AND parses
          the UVM report summary, emitting a `TestResult`:

          ```yaml
          - name: arb
            uses: hdlsim.vlt.SimUVMCase
            needs: [my-img]
            with: { testname: my_arb_test, plusargs: [SOME_ARG] }
          ```

          A suite is a matrix over (testname, plusargs) pairs. Give each cell a
          short `name` -- that is what `--tests` selects on.

          NOTE: expressions below are written `{{ ... }}`. In a real flow they
          take a leading dollar sign: `$` immediately followed by `{{ ... }}`.
          (This doc is itself a parameter value, so writing the real form here
          would expand it at load.)

          ```yaml
          - name: cases
            strategy:
              matrix:
                image: [tlm, rtl]
                case:
                - { name: arb, testname: my_arb_test, plusargs: [CMP] }
                - { name: err, testname: my_err_test, plusargs: [CMP] }
            body:
            - name: "{{ this.image }}-{{ this.case.name }}"
              uses: hdlsim.vlt.SimUVMCase
              needs: [ "{{ image_of[this.image] }}" ]
              with:
                name: "{{ this.image }}-{{ this.case.name }}"
                testname: "{{ this.case.testname }}"
                plusargs: "{{ this.case.plusargs }}"
          ```

          `SimSuiteReport` is the gate AND the project's test command (it
          `uses: std.TestRunner`):

          ```yaml
          - root: tests
            uses: hdlsim.SimSuiteReport
            needs: [cases]
          ```

          ```bash
          dfm run tests                      # everything; exit != 0 iff a case failed
          dfm exec tests --tests arb         # only that case
          dfm exec tests --views rtl         # only that image -- the others are NOT built
          dfm exec tests --detail full       # report every case
          ```

          Selection prunes the graph at BUILD time, so a deselected case is
          never built and neither is an image only it needed. A verdict is data,
          not a task failure, so every selected case runs to completion and the
          report decides the exit code. `junit.xml` is written into the report's
          rundir for CI (`junit: false` to disable).

          ## Multi-Simulator Support

          Use package parameters to select the simulator at build time:
          
          ```yaml
          package:
            name: my_project
            
            with:
              simulator:
                type: str
                value: vlt
            
            imports:
              - name: hdlsim.{simulator}  # Use variable reference syntax
                as: sim
            
            configs:
              - name: verilator
                with:
                  simulator:
                    value: vlt
              - name: vcs
                with:
                  simulator:
                    value: vcs
          ```
          
          Usage: `dfm run build -c vcs`

  - name: SimCompileArgs
    doc: Additional compilation arguments for SimImage
    with:
      args:
        doc: Compiler arguments
        type: list
      incdirs:
        doc: Include directories
        type: list
      defines:
        doc: Preprocessor defines
        type: list

  - name: SuppressWarnings
    doc: |
      A dataset carrying warning codes to suppress as markers.
      Connect to SimImage or SimLib via needs/dataflow to suppress
      specific simulator warnings project-wide.
      
      Example:
      ```yaml
      - name: suppress
        uses: hdlsim.SuppressWarnings
        with:
          codes: [TFIPC, MAXX]
      - name: build
        uses: sim.SimImage
        needs: [rtl, tb, suppress]
      ```
    with:
      codes:
        doc: Warning codes to suppress (e.g., TFIPC, vlog-2623, PINCONNECTS)
        type: list

  - name: SimElabArgs
    doc: Additional elaboration arguments for SimImage
    with:
      args:
        doc: Elaboration arguments
        type: list
      trace_fmt:
        doc: |
          Waveform trace format, and the build-time trace enable: "none"
          (off), "fst" or "vcd". A concrete backend maps a non-"none" value
          to its trace flag (e.g. Verilator --trace-fst / --trace). Debug
          arg presets default this from their package `trace_fmt` var (e.g.
          ${{ hdlsim.vlt.trace_fmt }}), so a single -D flips the format.
        type: str
        value: "none"
      dpilibs:
        doc: DPI libraries to link
        type: list
      vpilibs:
        doc: VPI libraries to link
        type: list

  - name: SimRunArgs
    doc: Additional runtime arguments for SimRun
    with:
      plusargs:
        doc: Simulation plusargs
        type: list
      args:
        doc: Runtime arguments
        type: list
      dpilibs:
        doc: DPI libraries to load
        type: list
      vpilibs:
        doc: VPI libraries to load
        type: list

  #------------------------------------------------------------------
  # Test-case / suite result carriers (SimCase / SimSuite infrastructure).
  #
  # SimRunResult   -- emitted by SimRun. Carries the *raw* simulator exit
  #                   status plus the collected artifact FileSets (sim log,
  #                   trace, coverage db). In `mode: test` the SimRun task
  #                   status stays 0 even when `status != 0`, so the verdict
  #                   travels as data (a Check task decides pass/fail).
  # TestResult     -- emitted by SimCheck/SimUVMCheck. The *interpreted*
  #                   per-case verdict (passed + severity counts) with the
  #                   artifacts forwarded from SimRunResult.
  # SuiteResult    -- emitted by SimSuiteReport. Roll-up over a suite's
  #                   TestResults; the report task's status gates CI.
  #------------------------------------------------------------------
  - name: SimRunResult
    doc: |
      Raw outcome of a single SimRun. `status` is the simulator process exit
      code (NOT the verdict -- a UVM $finish exits 0 with UVM_ERROR>0). In
      `mode: test` the SimRun task does not fail on nonzero `status`; the
      verdict is decided downstream by a Check task reading `artifacts`.
    with:
      status:
        doc: Simulator process exit code (0 == clean exit, not necessarily pass)
        type: int
        value: 0
      sim:
        doc: Simulator backend that produced this result (vlt/vcs/xsm/...)
        type: str
        value: ""
      mode:
        doc: SimRun mode this result was produced under ("run" or "test")
        type: str
        value: "run"
      walltime_s:
        doc: Wall-clock seconds spent in the simulator run
        type: float
        value: 0.0
      stats:
        doc: |
          Sparse map of measurements for this run. A key is present ONLY when
          it was actually measured -- an absent key means "this backend cannot
          report it", never zero. Keys (see dv_flow.libhdlsim.sim_stats for the
          authoritative registry, with units and suite-aggregation rules):

            host process (every backend, via GNU time):
              walltime_s, cpu_user_s, cpu_sys_s, cpu_total_s, cpu_pct,
              maxrss_mb, io_read_mb, io_write_mb, ctx_vol, ctx_invol
            simulator-reported (backend-dependent; Verilator today):
              simtime (as printed, eg '608us'), simtime_s, sim_walltime_s,
              sim_cpu_s, sim_mem_mb, threads, sim_speed_s_per_s
            log-derived (filled by the Check tasks):
              errors, warnings, fatals, infos
            testbench-reported (optional tb_stats.json in the rundir):
              cycles, transactions, plus any custom scalar counters
        type: map
      runinfo:
        doc: |
          Sparse map of provenance for this run -- what was run, how, and where:
          case_name, testname, sim, sim_version, mode, seed, seed_source, cmd,
          args, plusargs, dpilibs, vpilibs, imgdir, rundir, logfile, trace,
          valgrind, finish_reason, exit_code, host, user, nproc, start_time,
          end_time. Same sparse rule as `stats`: `seed` is absent (not 0) when
          no seed was explicitly applied.
        type: map
      artifacts:
        doc: Collected artifact FileSets (simLog / simStats / simTrace / simCovDb)
        type: list

  - name: TestResult
    doc: |
      Interpreted per-case verdict emitted by SimCheck/SimUVMCheck. `passed`
      is the authoritative pass/fail; the *_count fields carry the parsed UVM
      severity tallies; `artifacts` are forwarded from the SimRunResult.
    with:
      name:
        doc: Case name (matrix cell / SimCase instance name)
        type: str
        value: ""
      testname:
        doc: Test identity (e.g. UVM_TESTNAME) that was run
        type: str
        value: ""
      sim:
        doc: Simulator backend that ran the case
        type: str
        value: ""
      status:
        doc: Verdict status label ("pass" / "fail" / "error" / "timeout")
        type: str
        value: ""
      passed:
        doc: Authoritative pass/fail verdict
        type: bool
        value: false
      run_status:
        doc: Underlying simulator process exit code (from SimRunResult.status)
        type: int
        value: 0
      errors:
        doc: UVM_ERROR count parsed from the log
        type: int
        value: 0
      warnings:
        doc: UVM_WARNING count parsed from the log
        type: int
        value: 0
      fatals:
        doc: UVM_FATAL count parsed from the log
        type: int
        value: 0
      seed:
        doc: Simulation seed (0 when not captured; `runinfo.seed` is the sparse form)
        type: int
        value: 0
      walltime_s:
        doc: Wall-clock seconds spent in the simulator run
        type: float
        value: 0.0
      stats:
        doc: |
          Measurements forwarded from SimRunResult.stats, with the log-derived
          tallies (errors/warnings/fatals/infos) added by the Check task. Sparse:
          an absent key was not measured. See SimRunResult.stats for the key set.
        type: map
      runinfo:
        doc: Provenance forwarded from SimRunResult.runinfo (see that field)
        type: map
      artifacts:
        doc: Artifact FileSets forwarded from SimRunResult (simLog / simStats / simTrace / simCovDb)
        type: list

  - name: SuiteResult
    doc: |
      Roll-up over a suite's TestResults, emitted by SimSuiteReport. The
      report task's status is nonzero iff `failed`/`errored` > 0 (the CI gate).
    with:
      total:
        doc: Total number of cases in the suite
        type: int
        value: 0
      passed:
        doc: Number of cases that passed
        type: int
        value: 0
      failed:
        doc: Number of cases that failed (verdict fail)
        type: int
        value: 0
      errored:
        doc: Number of cases that errored/timed out (no clean verdict)
        type: int
        value: 0
      results:
        doc: The per-case TestResult items in the suite
        type: list
      stats:
        doc: |
          Roll-up of the per-case `stats` maps, aggregated per each key's rule
          (sim_stats.STAT_KEYS): summed keys emit `<key>`, `<key>_max` and
          `<key>_mean`; max-only keys emit `<key>_max`. Keys no case reported
          stay absent. Eg walltime_s / walltime_s_max / walltime_s_mean,
          cpu_total_s, maxrss_mb_max, simtime_s.
        type: map

